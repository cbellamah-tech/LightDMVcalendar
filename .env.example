# Set automatically when Supabase is connected in Vercel's Storage tab
POSTGRES_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Required once: lets Chris and Liam create their own PINs on first sign-in
OWNER_SETUP_CODE=

# Optional: sign-in cookie key (otherwise derived from the Supabase secret)
AUTH_SECRET=

# Jobber app from developer.getjobber.com (callback: <site>/api/jobber/callback)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# JOBBER_API_VERSION=2025-04-16
# APP_URL=https://light-dm-vcalendar.vercel.app
