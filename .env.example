# Already set on Vercel when the Upstash Redis store is connected (the calendar uses it too)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required: long random string that signs login cookies (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
# Required once: lets Chris and Liam create their own PINs on first sign-in
OWNER_SETUP_CODE=

# Photos: add a Vercel Blob store (Storage tab) and this is set for you
BLOB_READ_WRITE_TOKEN=

# Jobber app from developer.getjobber.com (callback: <site>/api/jobber/callback)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Optional
# JOBBER_API_VERSION=2025-04-16
# APP_URL=https://light-dm-vcalendar.vercel.app
